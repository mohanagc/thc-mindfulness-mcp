{
  "name": "thc-mindfulness-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only remote MCP server for The Holistic Care's public mindfulness resources (games, guided practices, research, glossary, PanchaVikas). Sits on top of the public REST API at api.theholisticcare.com.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:contract": "node --import tsx --test tests/contract.test.ts",
    "smoke:production": "node --import tsx scripts/smoke-production.mts",
    "validate:registry": "node scripts/validate-registry.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
